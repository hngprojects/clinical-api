# --- App ---
PROJECT_NAME=Clinsights
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clinsights
POSTGRES_PORT=5432

# --- Redis (used by docker-compose) ---
REDIS_PORT=6379

# --- Database (used by the app; must match the Postgres vars above) ---
# Host machine (API via `uv run fastapi dev`):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinsights
# Inside docker-compose network (only if API runs in a container):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/clinsights

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=3
JWT_REFRESH_TOKEN_EXPIRES_MINUTES=5
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Server-side pepper used to hash OTPs at rest. Generate as for JWT_SECRET.
OTP_PEPPER=replace-me-with-a-long-random-string

# --- Resend (transactional email) ---
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Clinsights
ALLOW_STDOUT_EMAIL=false

# --- Celery (requires redis from docker compose) ---
CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# Optional result backend; leave blank to disable
CELERY_RESULT_BACKEND=

# --- AI (interpretation + chat; set at least one key) ---
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
